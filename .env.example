# Copie para .env (cp .env.example .env). Nunca commite o .env com segredos reais.

# String de conexão do MongoDB (obrigatória; a aplicação não inicia sem ela).
# Precisa ser um REPLICA SET: POST /loans e PATCH /loans/:id/return usam transações.
# Local sem Docker para a API: suba só o Mongo do compose (docker compose up mongo).
# directConnection=true é necessário porque o replica set anuncia o host "mongo:27017".
MONGODB_URI=mongodb://localhost:27017/biblioteca?replicaSet=rs0&directConnection=true
# Alternativa com Atlas (já é replica set):
# MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/biblioteca
# Obs.: com "docker compose up" a API usa a URI interna definida no docker-compose.yml
# (mongodb://mongo:27017/biblioteca?replicaSet=rs0) e ignora esta variável.

# Porta HTTP da API.
PORT=3000

# Segredo usado para assinar o JWT. Troque por um valor forte fora do desenvolvimento.
JWT_SECRET=troque-por-um-segredo-forte

# Tempo de expiração do token JWT (ex.: 1h, 30m, 7d).
JWT_EXPIRES_IN=1h

# Ambiente de execução (development | production).
NODE_ENV=development
